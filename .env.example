# Copy to .env and adjust for local/dev.
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_DATABASE_PATH=data/agent.db
# AGENT_LOG_LEVEL=info

# --- LLM ---
# Providers: llmgate | openai | dashscope | openrouter | anthropic
# Tool-calling needs OpenAI-compatible (anthropic tools not yet).
AGENT_LLM_PROVIDER=llmgate
AGENT_LLM_BASE_URL=https://llmgate.app/v1
AGENT_LLM_API_KEY=your-llmgate-api-key
AGENT_LLM_MODEL=gpt-oss-120b
AGENT_LLM_TIMEOUT_SEC=60
AGENT_LLM_MAX_RETRIES=3
# AGENT_SYSTEM_PROMPT=You are a helpful stock research assistant. Use tools when helpful.

# --- Agent / tools / workspace (Phase 4–5) ---
# Bootstrap markdown (AGENT.md, TOOLS.md, …) is seeded under this path on first serve.
AGENT_WORKSPACE_PATH=workspace
AGENT_MAX_TOOL_ITERATIONS=8

# Phase 6 surfaces (no extra env):
#   POST /v1/chat/stream  — SSE progress events
#   GET  /ws              — WebSocket RPC (connect, chat.send, ping)

# --- Security (Phase 7) ---
AGENT_POLICY_PATH=POLICY.yaml

# --- MCP (Phase 8) ---
# Copy mcp.example.json → mcp.json, enable a server (disabled=false), then restart
# or POST /v1/mcp/reload. Tools appear as mcp_{server}__{tool}.
AGENT_MCP_JSON=mcp.json
# Surfaces: GET /v1/mcp/servers , POST /v1/mcp/reload

# --- Skills + slash (Phase 9) ---
# Skills live at workspace/skills/<slug>/SKILL.md (seeded on first serve).
# Optional override: AGENT_SKILLS_PATH=/abs/path/to/skills
# Slash via chat: /help /skills /<slug>
# HTTP: GET /v1/skills , POST /v1/skills/reload
# CLI:  go run . skills list

# --- Auth / multi-tenant (Phase 10A) ---
# API key required on all routes except GET /health.
# Bootstraps alice (admin) + bob (operator) on serve.
# Override keys (optional):
# AGENT_BOOTSTRAP_KEY_ALICE=sk_alice_dev_change_me
# AGENT_BOOTSTRAP_KEY_BOB=sk_bob_dev_change_me
# Usage: Authorization: Bearer <key>
# Chat body may include agent_id (default). user_id NEVER from body.
# Surfaces: GET /v1/me , GET/POST /v1/agents , GET /v1/agents/{id}
# Workspace jail: workspace/private/{user_id}/{agent_slug}/
