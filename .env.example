# Copy to .env and adjust for local/dev.
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_DATABASE_PATH=data/agent.db
# AGENT_LOG_LEVEL=info

# --- LLM (Phase 3) ---
# Providers sẵn sàng: llmgate | openai | dashscope | openrouter | anthropic
# Chưa làm (cần OAuth/subprocess): codex | acp | claude_cli
AGENT_LLM_PROVIDER=llmgate
AGENT_LLM_BASE_URL=https://llmgate.app/v1
AGENT_LLM_API_KEY=your-llmgate-api-key
AGENT_LLM_MODEL=gpt-oss-120b
AGENT_LLM_TIMEOUT_SEC=60
AGENT_LLM_MAX_RETRIES=3
# AGENT_SYSTEM_PROMPT=You are a helpful stock research assistant.
